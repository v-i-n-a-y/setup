#!/bin/bash
# AUTOGENERATED — do not edit. Re-run cron/install.sh to regenerate.

set -uo pipefail

# cron runs with a minimal PATH (usually /usr/bin:/bin), so brew (/opt/homebrew/bin)
# and softwareupdate (/usr/sbin) would be "command not found". Set it explicitly.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/sbin:/sbin:/usr/bin:/bin:$PATH"

LOGFILE="$HOME/update.log"
TMPFILE="$(mktemp)"

# Keep the log from growing without bound over years of monthly runs:
# trim to the last ~512K once it passes ~1M.
if [[ -f "$LOGFILE" && "$(wc -c < "$LOGFILE")" -gt 1048576 ]]; then
    tail -c 524288 "$LOGFILE" > "$LOGFILE.tmp" && mv "$LOGFILE.tmp" "$LOGFILE"
fi
COMPUTER="$(hostname)"
MESSAGE="Automated Update Results for $COMPUTER:"

# Optional: BOT_TOKEN and CHAT_ID for Telegram notifications.
if [[ -f "$HOME/.config/crontab-updater/env" ]]; then
    # shellcheck disable=SC1091
    source "$HOME/.config/crontab-updater/env"
fi

run() {
    local command="$1"
    {
        echo "$(date)"
        echo "Running $command"
    } >> "$TMPFILE"
    eval "$command" >> "$TMPFILE" 2>&1
    local status=$?
    cat "$TMPFILE" >> "$LOGFILE"
    MESSAGE="$MESSAGE
$(cat "$TMPFILE")"
    : > "$TMPFILE"
    if [[ $status -ne 0 ]]; then
        MESSAGE="$MESSAGE
UPDATE FAILED ($command)"
        notify "$status"
        rm -f "$TMPFILE"
        exit 1
    fi
}

notify() {
    local title="Automatic Updates"
    local body
    if [[ "${1:-0}" -ne 0 ]]; then
        body="Update failed"
    else
        body="Update completed"
    fi

    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$title" "$body" || true
    elif command -v osascript >/dev/null 2>&1; then
        osascript -e "display notification \"$body\" with title \"$title\"" >/dev/null 2>&1 || true
    fi

    if [[ -n "${BOT_TOKEN:-}" && -n "${CHAT_ID:-}" ]]; then
        local response text
        # Telegram caps message text at 4096 chars; keep the tail of the log.
        text="$(printf '%s' "$MESSAGE" | tail -c 3900)"
        # --data-urlencode so '&' / '=' in command output can't corrupt the POST;
        # pass the token via a stdin config file (-K -) so it never lands in the
        # process argv (visible to other local users via ps / /proc).
        response=$(curl -s -w "%{http_code}" -o /dev/null -X POST \
            --data-urlencode chat_id="$CHAT_ID" \
            --data-urlencode text="$text" \
            -K - <<EOF
url = "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage"
EOF
        )
        if [[ "$response" -ne 200 ]]; then
            echo "Failed to send Telegram message. HTTP $response" >> "$LOGFILE"
        else
            echo "Telegram message sent." >> "$LOGFILE"
        fi
    fi
}

__COMMANDS__

notify 0
rm -f "$TMPFILE"
exit 0
