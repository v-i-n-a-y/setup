[user]
    name = Vinay
    # GitHub noreply address: keeps a personal mailbox out of this public repo and
    # out of commit metadata. Override per-repo (or via includeIf) on work boxes.
    email = 51179948+v-i-n-a-y@users.noreply.github.com

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    autoSetupRemote = true
    default = simple

[fetch]
    prune = true

[rebase]
    autoStash = true

[diff]
    algorithm = histogram
    colorMoved = default

[merge]
    conflictStyle = zdiff3

[core]
    excludesfile = ~/.config/git/ignore

[http]
    postBuffer = 524288000

[https]
    postBuffer = 524288000

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
